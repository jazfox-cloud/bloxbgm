---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { pageUrl, site } from "@/data/site";
---

<BaseLayout
  title={`How to Use Roblox Music IDs - ${site.name}`}
  description="A concise guide to using Roblox music IDs in boombox, radio, and music-enabled Roblox experiences."
  canonical={pageUrl("/how-to-use/")}
>
  <Header />
  <main id="main" class="container py-12">
    <div class="max-w-3xl">
      <p class="text-sm font-black uppercase tracking-[0.16em] text-pulse">Guide</p>
      <h1 class="mt-3 text-4xl font-black tracking-normal md:text-6xl">How to Use Roblox Music IDs</h1>
      <p class="mt-5 text-lg leading-8 text-white/68">
        Roblox audio availability changes by experience, permissions, and asset status. Treat candidate IDs as leads, then test them where you play.
      </p>
    </div>
    <div class="mt-8 grid gap-4 md:grid-cols-2">
      <section class="panel rounded-lg p-6">
        <h2 class="text-2xl font-black">Basic Steps</h2>
        <ol class="mt-5 grid gap-4 text-sm leading-6 text-white/68">
          <li><strong class="text-white">1.</strong> Open a Roblox experience that supports boombox, radio, or custom music IDs.</li>
          <li><strong class="text-white">2.</strong> Copy the numeric ID from BloxBGM.</li>
          <li><strong class="text-white">3.</strong> Paste it into the game audio input and test playback.</li>
          <li><strong class="text-white">4.</strong> If it fails, try another ID or mark it for recheck.</li>
        </ol>
      </section>
      <section class="panel rounded-lg p-6">
        <h2 class="text-2xl font-black">Why IDs Fail</h2>
        <ul class="mt-5 grid gap-4 text-sm leading-6 text-white/68">
          <li>Some experiences disable custom music or require a game pass.</li>
          <li>Roblox can remove, moderate, or permission-lock audio assets.</li>
          <li>Short preview IDs may work differently from full audio assets.</li>
          <li>Older lists can be stale even when the numeric ID still exists.</li>
        </ul>
      </section>
    </div>
  </main>
  <Footer />
</BaseLayout>
