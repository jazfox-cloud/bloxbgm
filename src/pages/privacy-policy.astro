---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import EmailLink from "@/components/EmailLink.astro";
import { pageUrl, site } from "@/data/site";
---

<BaseLayout title={`Privacy Policy - ${site.name}`} description="Read how BloxBGM handles accounts, credentials, analytics, advertising data, cookies, device information, and privacy contact requests." canonical={pageUrl("/privacy-policy/")}>
  <Header />
  <main id="main" class="container py-12">
    <article class="prose prose-invert max-w-3xl prose-headings:font-black prose-a:text-pulse">
      <h1>Privacy Policy</h1>
      <p>Last updated: July 27, 2026.</p>
      <p>BloxBGM does not require accounts, collect passwords, or ask for Roblox credentials.</p>
      <h2>Analytics and Ads</h2>
      <p>BloxBGM uses Google Analytics 4 to understand page visits, content usage, aggregate interaction performance, and site improvements. Analytics is configured for the production site and loads only after a visitor accepts analytics where consent is required.</p>
      <p>Analytics choices can be rejected, accepted, withdrawn, or reopened from the Privacy Choices control in the footer. Accepting analytics grants analytics storage only; ad storage, ad user data, and ad personalization remain denied by this site control.</p>
      <p>BloxBGM is not currently loading Google AdSense ad tags from this codebase, and this analytics banner is not a Google-certified advertising CMP. If advertising is added later, the advertising and CMP disclosures must be updated to match the live configuration.</p>
      <h2>Contact</h2>
      <p>For privacy questions, email <EmailLink />.</p>
    </article>
  </main>
  <Footer />
</BaseLayout>
