---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { pageUrl, site } from "@/data/site";
---

<BaseLayout title={`Privacy Policy - ${site.name}`} description="BloxBGM privacy policy." canonical={pageUrl("/privacy-policy/")}>
  <Header />
  <main id="main" class="container py-12">
    <article class="prose prose-invert max-w-3xl prose-headings:font-black prose-a:text-pulse">
      <h1>Privacy Policy</h1>
      <p>Last updated: July 11, 2026.</p>
      <p>BloxBGM does not require accounts, collect passwords, or ask for Roblox credentials.</p>
      <h2>Analytics and Ads</h2>
      <p>BloxBGM may use analytics and third-party advertising services, including Google AdSense. These providers may process IP addresses, browser and device information, page views, referral data, cookies, web beacons, or similar identifiers to measure traffic, prevent abuse, and serve or measure ads.</p>
      <p>Third-party vendors, including Google, may use advertising cookies based on a visitor's prior visits to this or other websites. Visitors can control or opt out of personalized Google advertising in <a href="https://adssettings.google.com/">Google Ads Settings</a>. Additional choices are available at <a href="https://www.aboutads.info/choices/">aboutads.info</a>.</p>
      <h2>Contact</h2>
      <p>For privacy questions, email <a href="mailto:hello@bloxbgm.com">hello@bloxbgm.com</a>.</p>
    </article>
  </main>
  <Footer />
</BaseLayout>
