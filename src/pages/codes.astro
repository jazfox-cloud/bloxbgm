---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import TrackTable from "@/components/TrackTable.astro";
import { pageUrl, site } from "@/data/site";
import { tracks } from "@/data/tracks";
---

<BaseLayout
  title={`Roblox Music IDs & Boombox Codes - ${site.name}`}
  description="Search Roblox music IDs by title, genre, mood, status, or audio ID, then copy a code to test in an experience that supports boombox audio."
  canonical={pageUrl("/codes/")}
>
  <Header />
  <main id="main" class="container py-12">
    <div class="mb-8 max-w-3xl">
      <p class="text-sm font-black uppercase tracking-[0.16em] text-volt">Music ID Table</p>
      <h1 class="mt-3 text-4xl font-black tracking-normal md:text-6xl">Roblox Music IDs & Boombox Codes</h1>
      <p class="mt-5 text-lg leading-8 text-white/68">
        Search by song, mood, genre, play style, or ID. Candidate means the ID is source-listed and still needs a fresh in-game boombox check.
      </p>
    </div>
    <section class="panel mb-8 rounded-lg p-5" aria-labelledby="video-sources-heading">
      <h2 id="video-sources-heading" class="text-xl font-black">Two music IDs with video sources</h2>
      <p class="mt-2 text-sm leading-6 text-white/62">
        Source review: September 20, 2026. These videos list the IDs below; they do not establish current playback in every Roblox experience. Both remain candidates, not in-game verified IDs.
      </p>
      <ul class="mt-4 space-y-3 text-sm leading-6 text-white/74">
        <li>
          <strong class="text-white">Tokyo Drift — Fumitake Igarashi:</strong> <code class="text-pulse">1837015626</code>.
          <a class="text-pulse underline" href="https://www.youtube.com/shorts/Seo4-I01fI0">NeonRBLX video code list</a> shows this ID; it is a list, not an in-game playback test.
        </li>
        <li>
          <strong class="text-white">Raining Tacos — Parry Gripp:</strong> <code class="text-pulse">142376088</code>.
          <a class="text-pulse underline" href="https://www.youtube.com/watch?v=soJP_KGvT9g">MySpaceGuide video</a> lists this ID in its description. We have not confirmed playback from the footage reviewed.
        </li>
      </ul>
      <p class="mt-4 text-sm leading-6 text-white/62">
        To try an ID, paste the number into a supported game's boombox or radio input. Playback depends on that experience's features and audio permissions.
        <a class="text-pulse underline" href="/how-to-use/">Read the music ID usage guide</a>.
      </p>
    </section>
    <TrackTable tracks={tracks} />
    <section class="mt-8 grid gap-4 md:grid-cols-3">
      <div class="panel rounded-lg p-5">
        <h2 class="text-lg font-black">Status labels</h2>
        <p class="mt-2 text-sm leading-6 text-white/62">Verified IDs have a checked date. Candidate IDs are useful leads but should be tested before relying on them.</p>
      </div>
      <div class="panel rounded-lg p-5">
        <h2 class="text-lg font-black">Copy workflow</h2>
        <p class="mt-2 text-sm leading-6 text-white/62">Use the copy button, then paste the numeric ID into a Roblox experience that supports boombox or radio audio.</p>
      </div>
      <div class="panel rounded-lg p-5">
        <h2 class="text-lg font-black">Updates</h2>
        <p class="mt-2 text-sm leading-6 text-white/62">Unavailable IDs should be kept in the dataset as history, then filtered down in the public table.</p>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
