---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { pageUrl, site } from "@/data/site";
---

<BaseLayout title={`Page Not Found - ${site.name}`} description="The BloxBGM page could not be found." canonical={pageUrl("/404/")}>
  <Header />
  <main id="main" class="container py-16">
    <section class="panel max-w-2xl rounded-lg p-8">
      <p class="text-sm font-black uppercase tracking-[0.16em] text-coral">404</p>
      <h1 class="mt-3 text-4xl font-black">Page not found</h1>
      <p class="mt-4 text-white/64">The page may have moved, or the playlist has not been published yet.</p>
      <a class="mt-6 inline-flex rounded-md bg-volt px-5 py-3 font-black text-ink" href="/codes/">Search music IDs</a>
    </section>
  </main>
  <Footer />
</BaseLayout>
