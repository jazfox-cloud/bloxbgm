---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { site } from "@/data/site";
---

<BaseLayout
  title={`Page Not Found - ${site.name}`}
  description="The BloxBGM page could not be found."
  canonical={null}
  robots="noindex, follow"
>
  <Header />
  <main id="main" class="container py-16">
    <section class="panel max-w-2xl rounded-lg p-8">
      <p class="text-sm font-black uppercase tracking-[0.16em] text-coral">404</p>
      <h1 class="mt-3 text-4xl font-black">Page not found</h1>
      <p class="mt-4 text-white/64">The page may have moved, or the playlist has not been published yet.</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a class="inline-flex rounded-md bg-volt px-5 py-3 font-black text-ink" href="/">Return home</a>
        <a class="inline-flex rounded-md border border-white/14 px-5 py-3 font-black text-white" href="/codes/">Search music IDs</a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
