---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import TrackTable from "@/components/TrackTable.astro";
import { site } from "@/data/site";
import { candidateTracks, tracks, verifiedTracks } from "@/data/tracks";
import { playlists } from "@/data/playlists";

const featuredTracks = tracks.slice(0, 8);
---

<BaseLayout>
  <Header />
  <main id="main">
    <section class="container grid gap-8 py-12 lg:grid-cols-[1fr_440px] lg:items-center lg:py-16">
      <div>
        <p class="text-sm font-black uppercase tracking-[0.18em] text-volt">Roblox Music IDs</p>
        <h1 class="mt-4 max-w-3xl text-5xl font-black leading-tight tracking-normal md:text-7xl">
          BloxBGM
        </h1>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-white/70">
          Search Roblox music IDs and pick BGM by scene: speedrun, PvP, building, tycoon, hangout, and roleplay.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a class="rounded-md bg-volt px-5 py-3 font-black text-ink transition hover:bg-white" href="/codes/" data-analytics-event="select_content" data-analytics-content-type="nav_card" data-analytics-content-slug="codes" data-analytics-placement="home_hero">Search music IDs</a>
          <a class="rounded-md border border-white/14 px-5 py-3 font-black text-white transition hover:border-pulse hover:text-pulse" href="/playlists/speedrun-phonk/" data-analytics-event="select_content" data-analytics-content-type="playlist_card" data-analytics-content-slug="speedrun-phonk" data-analytics-placement="home_hero">Browse playlists</a>
        </div>
        <dl class="mt-8 grid max-w-2xl grid-cols-3 gap-3">
          <div class="panel rounded-lg p-4">
            <dt class="text-xs uppercase tracking-wide text-white/42">Tracks</dt>
            <dd class="mt-1 text-2xl font-black">{tracks.length}</dd>
          </div>
          <div class="panel rounded-lg p-4">
            <dt class="text-xs uppercase tracking-wide text-white/42">Verified</dt>
            <dd class="mt-1 text-2xl font-black">{verifiedTracks.length}</dd>
          </div>
          <div class="panel rounded-lg p-4">
            <dt class="text-xs uppercase tracking-wide text-white/42">Candidates</dt>
            <dd class="mt-1 text-2xl font-black">{candidateTracks.length}</dd>
          </div>
        </dl>
      </div>
      <div class="panel overflow-hidden rounded-lg">
        <img class="aspect-[16/10] w-full object-cover" src="/brand-wave.svg" alt="BloxBGM waveform visual" width="960" height="540" />
        <div class="border-t border-white/10 p-5">
          <p class="text-sm font-bold text-white">Current data policy</p>
          <p class="mt-2 text-sm leading-6 text-white/62">{site.dataPolicy}</p>
        </div>
      </div>
    </section>

    <section class="container py-8">
      <div class="mb-5 flex items-end justify-between gap-4">
        <div>
          <p class="text-sm font-black uppercase tracking-[0.16em] text-pulse">Quick Search</p>
          <h2 class="mt-2 text-3xl font-black">Featured Roblox Music IDs</h2>
        </div>
        <a class="hidden text-sm font-black text-volt hover:text-white md:inline" href="/codes/">View all</a>
      </div>
      <TrackTable tracks={featuredTracks} compact />
    </section>

    <section class="container py-10">
      <div class="mb-6">
        <p class="text-sm font-black uppercase tracking-[0.16em] text-coral">Playlists</p>
        <h2 class="mt-2 text-3xl font-black">Scene-Based BGM Packs</h2>
      </div>
      <div class="grid gap-4 md:grid-cols-3">
        {playlists.map((playlist) => (
          <a class="panel rounded-lg p-5 transition hover:-translate-y-1 hover:border-pulse/70" href={`/playlists/${playlist.slug}/`} data-analytics-event="select_content" data-analytics-content-type="playlist_card" data-analytics-content-slug={playlist.slug} data-analytics-placement="home_playlists">
            <p class="text-xs font-black uppercase tracking-wide text-volt">{playlist.eyebrow}</p>
            <h3 class="mt-3 text-xl font-black">{playlist.title}</h3>
            <p class="mt-3 text-sm leading-6 text-white/62">{playlist.description}</p>
            <p class="mt-5 text-sm font-black text-pulse">{playlist.trackIds.length} IDs</p>
          </a>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
