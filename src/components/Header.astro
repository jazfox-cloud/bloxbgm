---
import { site } from "@/data/site";

const nav = [
  { href: "/codes/", label: "Music IDs" },
  { href: "/playlists/speedrun-phonk/", label: "Playlists" },
  { href: "/how-to-use/", label: "How to Use" },
  { href: "/about/", label: "About" }
];
---

<header class="border-b border-white/10 bg-ink/88 backdrop-blur">
  <div class="container flex min-h-16 items-center justify-between gap-4 py-3">
    <a class="flex items-center gap-3" href="/" aria-label={`${site.name} home`}>
      <img class="h-8 w-8" src="/favicon.svg" alt="" width="32" height="32" />
      <span class="text-lg font-black tracking-normal">{site.name}</span>
    </a>
    <nav class="hidden items-center gap-1 md:flex" aria-label="Main navigation">
      {nav.map((item) => (
        <a class="rounded-md px-3 py-2 text-sm font-semibold text-white/76 transition hover:bg-white/8 hover:text-white" href={item.href}>
          {item.label}
        </a>
      ))}
    </nav>
    <a class="rounded-md border border-volt/50 bg-volt px-4 py-2 text-sm font-black text-ink transition hover:bg-white" href="/codes/">
      Search IDs
    </a>
  </div>
</header>
