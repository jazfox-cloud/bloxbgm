<button
  type="button"
  class="email-link cursor-pointer border-0 bg-transparent p-0 font-inherit text-pulse underline"
  data-email-link
>
  Show email address
</button>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-email-link]")) {
    const local = "hello";
    const domain = ["bloxbgm", "com"].join(".");
    const address = [local, domain].join("@");
    const link = document.createElement("a");

    link.className = button.className.replace("email-link", "");
    link.href = `mailto:${address}`;
    link.textContent = address;
    button.replaceWith(link);
  }
</script>
